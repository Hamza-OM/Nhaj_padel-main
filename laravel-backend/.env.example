APP_NAME="Padel Court Booking Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Use sqlite for the fastest local setup (default). Switch to mysql/pgsql for production.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=padel_booking
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Frontend origin(s) allowed to call this API (comma-separated for multiple).
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Thawani Payment Gateway
# THAWANI_MODE: "uat" (or "sandbox") for testing against uatcheckout.thawani.om,
# "production" for live checkout.thawani.om / checkoutapi.thawani.om.
THAWANI_MODE=uat
THAWANI_SECRET_KEY=rQ0w...
THAWANI_PUBLISHABLE_KEY=HG9w...
# From Merchant Portal > Webhook config. Required to verify incoming webhooks are
# genuinely from Thawani (HMAC-SHA256 signature check) — leave blank only if you
# have no public webhook URL configured yet.
THAWANI_WEBHOOK_SECRET=
