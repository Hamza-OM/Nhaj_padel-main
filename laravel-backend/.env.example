APP_NAME="Padel Court Booking Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Slot times, opening hours, and the cancellation window are all club-local.
# Leaving this as UTC makes the server believe it is 4 hours earlier than the
# venue, so slots that have already started stay bookable.
APP_TIMEZONE=Asia/Muscat
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Use sqlite for the fastest local setup (default). Switch to mysql/pgsql for production.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=padel_booking
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Booking confirmation email. Any SMTP provider works — the app only uses
# Laravel's standard `smtp` mailer, so nothing here is provider-specific.
#
# The settings below are for Resend (resend.com): create a free account, then
# Settings > API Keys, and paste the key as MAIL_PASSWORD. Note that on the
# free tier the onboarding@resend.dev sender can only deliver to the address
# you registered with — verify your own domain to send to anyone else.
#
# Leave MAIL_MAILER=log instead if you just want confirmation emails written
# to storage/logs/laravel.log rather than actually delivered.
MAIL_MAILER=log
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="PadelPoint Muscat"

# Frontend origin(s) allowed to call this API (comma-separated for multiple).
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Thawani Payment Gateway.
# THAWANI_MODE: "uat" (or "sandbox") for testing against uatcheckout.thawani.om,
# "production" for live checkout.thawani.om / checkoutapi.thawani.om.
# The values below are Thawani's own publicly documented UAT test credentials
# (https://developer.thawani.om/), shared by Thawani for any developer to use
# in sandbox mode — not a secret, safe to commit. They work out of the box for
# local dev / grading. For production, get your own keys from the Thawani
# merchant portal (Settings > Developers) and NEVER commit those — only the
# shared UAT ones above are meant to live in version control.
THAWANI_MODE=uat
THAWANI_SECRET_KEY=rRQ26GcsZzoEhbrP2HZvLYDbn9C9et
THAWANI_PUBLISHABLE_KEY=HGvTMLDssJghr9tlN9gr4DVYt0qyBy
# Optional — defaults are derived from THAWANI_MODE if these are left blank.
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_CHECKOUT_URL=https://uatcheckout.thawani.om/pay
# From Merchant Portal > Webhook config. Required to verify incoming webhooks are
# genuinely from Thawani (HMAC-SHA256 signature check) — leave blank only if you
# have no public webhook URL configured yet.
THAWANI_WEBHOOK_SECRET=

# Admin dashboard login (seeded by DatabaseSeeder via `php artisan migrate --seed`).
# Change these before deploying anywhere beyond local dev.
ADMIN_EMAIL=admin@padel.com
ADMIN_PASSWORD=Demo-5e977ff12f8c
