# The React frontend is a static SPA served by Vite (dev) or any static host (prod).
# All API calls are proxied to the Laravel backend via vite.config.ts.

# Must match ADMIN_API_KEY in laravel-backend/.env — sent as the X-Admin-Key header
# on every /api/admin/* request. Note: since this is a static SPA with no
# server-side rendering, this value ships inside the built JS bundle and is
# visible to anyone who opens dev tools. It stops opportunistic/blind access
# (scanners, guessed URLs) but is not equivalent to real per-user authentication.
VITE_ADMIN_API_KEY=
